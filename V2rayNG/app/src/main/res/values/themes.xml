<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="window_background_light">#FFF3F6F9</color>
    <color name="window_background_dark">#FF000000</color>
    <color name="satra_splash_background">#FF0B0B0C</color>

    <style name="Theme.Satra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/satra_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/satra_splash_shield</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/AppThemeDayNight.NoActionBar</item>
    </style>

    <style name="AppThemeBaseCommon" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <!-- API 27+ adds navigation bar icon appearance in the versioned base theme. -->
    <style name="AppThemeBase" parent="AppThemeBaseCommon" />

    <style name="AppThemeDayNight" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar.Translucent" parent="AppThemeBase">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
